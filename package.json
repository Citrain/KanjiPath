{
  "name": "kanjipath",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File dev.ps1",
    "dev:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File dev.ps1 -SetupOnly",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && pnpm -r --if-present test && vitest run tools/content/test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @kanjipath/api prisma:generate",
    "db:migrate": "pnpm --filter @kanjipath/api prisma:migrate",
    "db:deploy": "pnpm --filter @kanjipath/api prisma:deploy",
    "content:download": "node tools/content/run.mjs download",
    "content:import": "node tools/content/run.mjs import",
    "content:normalize": "node tools/content/run.mjs normalize",
    "content:generate": "node tools/content/run.mjs generate",
    "content:validate": "node tools/content/run.mjs validate",
    "content:report": "node tools/content/run.mjs report",
    "content:publish": "node tools/content/run.mjs publish",
    "content:build": "node tools/content/run.mjs all",
    "content:load": "node tools/content/run.mjs load"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@prisma/client": "^6.19.3",
    "fast-xml-parser": "^5.10.1",
    "kuromoji": "^0.1.2",
    "tar": "^7.5.22",
    "typescript": "^5.9.3",
    "unbzip2-stream": "^1.4.3",
    "vitest": "^4.1.10",
    "yauzl": "^3.4.0"
  }
}
